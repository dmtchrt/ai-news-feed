# Local development secrets template.
#
# Setup (once):
#   cp .env.example .env
# then open .env and replace the CHANGE_ME placeholders with your real values.
# .env itself is already covered by .gitignore (.env / *.env patterns) -- it will
# never be committed. This .env.example file has no real secrets, so it's fine
# to commit and keep in git.
#
# Usage (every time, instead of manually exporting each variable):
#   uv run --env-file .env ai-news-feed-bot
#   uv run --env-file .env ai-news-feed-pipeline
#
# This file is for local runs on your machine only. It has nothing to do with
# GitHub Actions (those secrets live in the repo's Actions settings) or the VPS
# deployment of bot-worker (see deploy/.env.example and deploy/README.md).

# --- Required to run either command ---
DATABASE_URL=postgresql://CHANGE_ME@CHANGE_ME.neon.tech/ai_news_feed?sslmode=require
TELEGRAM_BOT_TOKEN=CHANGE_ME

# --- Required for ai-news-feed-bot (bot-worker) ---
# Your numeric Telegram user id -- only this user can use the bot's private-chat menu.
TELEGRAM_OWNER_USER_ID=CHANGE_ME

# --- Required for ai-news-feed-pipeline, and for the bot's "Собрать за период"
#     (backfill) button to actually run instead of replying "не настроено" ---
TELEGRAM_CHANNEL_ID=CHANGE_ME
OPENAI_API_KEY=CHANGE_ME
OPENAI_SCREENING_MODEL=CHOOSE_MODEL_EXPLICITLY
OPENAI_SUMMARY_MODEL=CHOOSE_MODEL_EXPLICITLY

# --- Optional (sensible defaults if left out) ---
# INTEREST_PROFILE_ID=default
# OPENAI_BASE_URL=https://api.openai.com/v1
# SEMHASH_MODEL=...

# --- Only needed if you have a source with collector=telethon ---
# TELEGRAM_API_ID=CHANGE_ME
# TELEGRAM_API_HASH=CHANGE_ME
# TELEGRAM_SESSION=CHANGE_ME
