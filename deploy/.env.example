# Copy to /etc/ai-news-feed/bot.env on the VPS. Never commit the real file.
# Owner/mode: root:root 0600. Values must not be shared with rus-ai.com.

# Dedicated AI News Feed Neon project, never the rus-ai.com connection string.
# Neon production URLs must require TLS (normally sslmode=require).
DATABASE_URL=postgresql://AI_NEWS_FEED_ROLE:CHANGE_ME@CHANGE_ME.neon.tech/ai_news_feed?sslmode=require

# Bot-worker: private-chat configuration UI (sources/interests/digest settings).
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_OWNER_USER_ID=123456789
INTEREST_PROFILE_ID=default
LOG_LEVEL=INFO

# These belong in GitHub Actions secrets for pipeline-runner regardless of the section
# below: TELEGRAM_CHANNEL_ID, OPENAI_API_KEY, OPENAI_SCREENING_MODEL, OPENAI_SUMMARY_MODEL,
# and (only if a source uses collector=telethon) TELEGRAM_API_ID/API_HASH/SESSION.

# Optional -- uncomment to enable the bot's in-chat "Собрать за период" backfill button.
# This gives bot-worker the SAME collection/LLM/channel-posting access as pipeline-runner,
# i.e. these secrets then live on the VPS in addition to GitHub Actions (a deliberate
# relaxation of the isolation above, made so the button can reply synchronously in chat
# instead of only via a delayed GitHub Actions run). Leave commented out to keep the VPS
# holding only the minimal secrets above -- the button then just tells the owner it isn't
# configured, and the rest of bot-worker is unaffected.
# TELEGRAM_CHANNEL_ID=-1001234567890
# OPENAI_API_KEY=CHANGE_ME
# OPENAI_SCREENING_MODEL=CHOOSE_MODEL_EXPLICITLY
# OPENAI_SUMMARY_MODEL=CHOOSE_MODEL_EXPLICITLY
# # Only if a source uses collector=telethon:
# TELEGRAM_API_ID=123456
# TELEGRAM_API_HASH=CHANGE_ME
# TELEGRAM_SESSION=CHANGE_ME
