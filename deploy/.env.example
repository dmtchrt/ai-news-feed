# Copy to /etc/ai-news-feed/bot.env on the VPS. Never commit the real file.
# Owner/mode: root:root 0600. Values must not be shared with rus-ai.com.

# Dedicated AI News Feed Neon project, never the rus-ai.com connection string.
# Neon production URLs must require TLS (normally sslmode=require).
DATABASE_URL=postgresql://AI_NEWS_FEED_ROLE:CHANGE_ME@CHANGE_ME.neon.tech/ai_news_feed?sslmode=require

# Bot-worker: private-chat configuration UI only.
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_OWNER_USER_ID=123456789
INTEREST_PROFILE_ID=default
LOG_LEVEL=INFO

# The following variables belong in GitHub Actions secrets, not the VPS bot.env.
# TELEGRAM_CHANNEL_ID=-1001234567890
# OPENAI_API_KEY=CHANGE_ME
# OPENAI_SCREENING_MODEL=CHOOSE_MODEL_EXPLICITLY
# OPENAI_SUMMARY_MODEL=CHOOSE_MODEL_EXPLICITLY
# TELEGRAM_API_ID=123456
# TELEGRAM_API_HASH=CHANGE_ME
# TELEGRAM_SESSION=CHANGE_ME
